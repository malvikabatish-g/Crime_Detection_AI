import cv2
"D:\Malvika\fight clips\fightFrames\Fighting006_x264\Fighting006_x264_0001.jpg"
import os
#"D:\Malvika\Downloads\Java Lab Exam AC February 2026.docx"
VIDEO_FOLDER = "D:/Malvika/fight clips/fight videos"
OUTPUT_FOLDER = "D:/Malvika/dataset"

FRAME_INTERVAL = 30  # 1 frame/sec for 30 FPS videos

for class_name in ["fight", "normal"]:

    video_dir = os.path.join(VIDEO_FOLDER, class_name)
    output_dir = os.path.join(OUTPUT_FOLDER, class_name)

    os.makedirs(output_dir, exist_ok=True)

    for video_file in os.listdir(video_dir):

        video_path = os.path.join(video_dir, video_file)

        cap = cv2.VideoCapture(video_path)

        count = 0
        saved = 0

        video_name = os.path.splitext(video_file)[0]

        while True:
            ret, frame = cap.read()

            if not ret:
                break

            if count % FRAME_INTERVAL == 0:

                filename = f"{video_name}_{saved}.jpg"

                cv2.imwrite(
                    os.path.join(output_dir, filename),
                    frame
                )

                saved += 1

            count += 1

        cap.release()

        print(f"{video_file} -> {saved} frames")